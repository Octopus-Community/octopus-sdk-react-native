{
  "name": "@octopus-community/react-native-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "ios:pod": "cd ios && bundle exec pod install",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "build:android": "react-native build-android --extra-params \"--no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a\"",
    "build:ios": "react-native build-ios --scheme OctopusReactNativeSdkExample --mode Debug --extra-params \"-sdk iphonesimulator GCC_OPTIMIZATION_LEVEL=0 GCC_PRECOMPILE_PREFIX_HEADER=YES ASSETCATALOG_COMPILER_OPTIMIZATION=time DEBUG_INFORMATION_FORMAT=dwarf COMPILER_INDEX_STORE_ENABLE=NO\"",
    "clean:ios": "cd ios && rm -rf build Pods Podfile.lock && pod cache clean --all && cd ..",
    "clean:android": "cd android && ./gradlew clean && cd .. && rm -rf android/app/build android/build android/.gradle",
    "clean:all": "yarn clean:ios && yarn clean:android && rm -rf node_modules/.cache",
    "android:release": "react-native run-android --mode release",
    "ios:release": "react-native run-ios --scheme OctopusReactNativeSdkExample --mode Release",
    "rebuild:ios:release": "yarn clean:ios && cd ios && bundle exec pod install && cd .. && yarn ios:release",
    "rebuild:android:release": "yarn clean:android && yarn android:release"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/messaging": "^24.0.0",
    "@react-native-vector-icons/material-icons": "^13.1.3",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-webview": "^13.12.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.81.4",
    "@react-native/metro-config": "0.81.4",
    "@react-native/typescript-config": "0.81.4",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "env-cmd": "^10.1.0",
    "react-native-builder-bob": "^0.40.12",
    "react-native-dotenv": "^3.4.11",
    "react-test-renderer": "19.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
