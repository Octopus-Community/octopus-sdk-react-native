# Copy to `.env` (gitignored) and fill in. Every value is optional: with none of
# them set the sample still launches, and the Config screen explains what is
# missing instead of failing.

# Generic demo API key, used when no named key set is injected.
OCTOPUS_COMMUNITY_API_KEY=

# Optional named key sets shown as a picker on the Config screen.
# Format: id~label~key, entries separated by `;`.
OCTOPUS_NAMED_API_KEYS=

# SSO test user: the JWT `sub` plus one pre-baked token per entitlement
# combination the Connection scenario walks. Only the first is required.
OCTOPUS_SSO_USER_ID=
OCTOPUS_SSO_USER_TOKEN=
OCTOPUS_SSO_USER_TOKEN_PREMIUM=
OCTOPUS_SSO_USER_TOKEN_MODERATOR=
OCTOPUS_SSO_USER_TOKEN_PREMIUM_MODERATOR=

# Optional demo content id overrides; blank uses the sampleFixtures defaults.
# DEMO_POST_ID overrides the text/notification and reaction targets; the dedicated
# reaction override wins for reactions. Restart Metro with start:reset after edits.
OCTOPUS_DEMO_POST_ID=
OCTOPUS_QA_REACTION_POST_ID=
OCTOPUS_QA_COMMENT_ID=
OCTOPUS_QA_USER_ID=
OCTOPUS_QA_TOPIC_ID=

# The backend this build talks to. Passed to `initialize()` as `apiServer`, which
# both native SDKs honour — so this really does reroute the SDK, published
# artifacts included. A scheme, a port and a trailing path are tolerated and
# normalized (`https://api-demo2.8pus.io/` → host `api-demo2.8pus.io`).
# Left empty, the sample talks to the DEMO backend (api-demo2.8pus.io): an
# unconfigured checkout must not be able to write test content into real client
# communities. Set it to api.8pus.io to target PRODUCTION on purpose — an
# internal build then says so with a banner, see OCTOPUS_INTERNAL below.
OCTOPUS_API_HOST=

# Set to `true` in your own `.env` if you are an Octopus developer. It changes
# nothing the SDK does — it only re-enables an internal safety net: the
# production banner needs BOTH this marker AND a production backend. Nothing sets
# it for you, so set it once and forget it; without it a build that names
# api.8pus.io says nothing about it. A host building this mirror leaves it empty
# and never sees the banner, which is the point.
OCTOPUS_INTERNAL=
# Optional. A pre-signed bridge-share JWT, used only by the demo signer in App.tsx when the
# community forbids member pictures. Leave empty unless you are testing that case: a real host
# signs each request on its backend and never carries a signing secret in the app.
OCTOPUS_BRIDGE_SHARE_TOKEN=

# Optional HTTPS URL for Settings > About > Design reference. Hidden when empty.
OCTOPUS_DESIGN_REFERENCE_URL=
# Optional owner/repository-private for internal feedback. No default destination.
# The operator must verify that the configured repository is private.
OCTOPUS_FEEDBACK_REPO=
