{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    // `build:android` and `build:ios` are declared in `example/package.json`, so
    // every glob below is resolved relative to `example/` — NOT to the repo root.
    // The SDK's own sources therefore have to be reached with `../`, and a bare
    // directory name never expands to its files: only an explicit `**` does.
    // Getting either wrong empties the task hash of all native code, so CI
    // reports a cache hit and silently skips the build it is meant to gate.
    // `scripts/__tests__/turboNativeInputs.test.ts` asserts what turbo really
    // resolves here, because neither mistake is visible in a diff.
    //
    // `yarn.lock` is deliberately absent: turbo already folds the resolved
    // dependency set into the task hash on its own (`hashOfExternalDependencies`).
    //
    // Every `!…` line below is load-bearing. With `inputs`, turbo 1.13 hashes
    // every file on disk the globs match, gitignored or not (measured
    // 2026-10-19). So build outputs, `Pods/` and `.gradle/` have to be
    // subtracted, and so does `ios/.xcode.env.local`: `pod install` writes it
    // between the cache probe and the build, with the runner's node path,
    // which differs between runners. Hashed, it made the build's hash differ
    // from the probe's. `android/app/google-services.json` is the opposite
    // case: the google-services plugin reads it, so it is a real build input,
    // stays hashed, and CI writes it before the probe. The two
    // `!…/src/__tests__/**` lines keep the unit tests, which live inside both
    // hashed source trees, out: a test-only edit must not invalidate a native
    // build.
    //
    // On a turbo 2.x upgrade, `../x/**` becomes `$TURBO_ROOT$/x/**`: parent
    // traversal works and is asserted at 1.13.x, but the supported spelling for
    // a root-relative input is the 2.x microsyntax.
    //
    // `outputs: []` on both tasks is intentional, not an omission: CI consumes
    // nothing from these builds — the job exists to prove the example still
    // compiles — so the only value of a cache HIT is skipping the build
    // entirely, which an empty outputs list already provides. Declaring the
    // built .app/.apk as outputs would push hundreds of MB per hash into
    // .turbo/ and through actions/cache for artifacts nobody reads.
    "build:android": {
      "env": ["ORG_GRADLE_PROJECT_newArchEnabled"],
      "inputs": [
        "../package.json",
        "../android/**",
        "!../android/build/**",
        "../src/**",
        "!../src/__tests__/**",
        "package.json",
        "react-native.config.js",
        "android/**",
        "!android/.gradle/**",
        "!android/build/**",
        "!android/app/build/**",
        "src/**",
        "!src/__tests__/**"
      ],
      "outputs": []
    },
    "build:ios": {
      "env": ["RCT_NEW_ARCH_ENABLED"],
      "inputs": [
        "../package.json",
        "../*.podspec",
        "../ios/**",
        "!../ios/build/**",
        "../src/**",
        "!../src/__tests__/**",
        "package.json",
        "react-native.config.js",
        // The CocoaPods the `Install cocoapods` CI step runs with.
        "Gemfile",
        "Gemfile.lock",
        "ios/**",
        "!ios/build/**",
        "!ios/Pods/**",
        "!ios/.xcode.env.local",
        "src/**",
        "!src/__tests__/**"
      ],
      "outputs": []
    }
  }
}
